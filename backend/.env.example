# Telegram Bot Token (для Mini App)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database
# Для локальной разработки (SQLite)
DATABASE_URL=sqlite+aiosqlite:///mushroom_app.db

# Для продакшена (PostgreSQL на Render/Railway)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Для Supabase (Pooler URL - рекомендуется для продакшена)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# App settings
DEBUG=false

# CORS origins (через запятую для множественных доменов)
CORS_ORIGINS=https://mushroom-app.vercel.app,https://localhost:3000,https://localhost:5173

# Для продакшена (Render)
# VITE_API_URL=https://mushroom-api.onrender.com/api

# Для Railway
# VITE_API_URL=https://your-app-name.railway.app/api
